<!doctype html>
<html class="no-js no-touch supports-no-cookies" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head' -%}

    {{ content_for_header }}

    {%- comment -%} ===== CUSTOM STYLES (Emma Frankfurt) ===== {%- endcomment -%}
    <style>
      /* ===== GRID / COLEÇÕES ===== */
      .product-item__price .new-price { color: #c00000 !important; font-weight: 700; }
      .product-item__price .old-price { color: #9a9a9a !important; text-decoration: line-through; }
      .sale-box { background-color: #ffffff !important; color: #111111 !important; }
      .quick-add__holder,
      quick-add-product { display: none !important; }
      .grid__heading-holder {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: nowrap !important;
        gap: 12px;
      }
      .grid__heading-actions { flex: 0 0 auto; }
      .grid__heading-text { flex: 1 1 auto; min-width: 0; }

      /* ===== PRODUCT PAGE — PREÇO ===== */
      .product__price {
        display: flex !important;
        align-items: center !important;
        gap: 8px;
        flex-wrap: nowrap;
      }
      .product__price--strike { order: 1; font-size: 16px; color: #222222 !important; text-decoration: line-through; }
      .product__price--sale  { order: 2; font-size: 20px; color: #ff0000 !important; font-weight: 700; }
      .product__price--off--custom {
        order: 3;
        background: #149b58;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 4px;
        line-height: 1;
        white-space: nowrap;
      }
      /* esconder a badge nativa separada (usamos a de dentro do preço) */
      .product__sale { display: none !important; }
      .product__final-sale-wrap { display: none !important; }

      /* botão Add to cart dourado (estilo Sarah) */
      .product__submit__buttons .btn,
      button[data-add-to-cart] {
        background: #d8a44a !important;
        border-color: #d8a44a !important;
        color: #1a1a1a !important;
        text-transform: none !important;
        letter-spacing: 0.02em;
      }
      .product__submit__buttons .btn:hover,
      button[data-add-to-cart]:hover {
        background: #cb9736 !important;
        border-color: #cb9736 !important;
      }

      /* ===== PRODUCT PAGE — BREADCRUMB ===== */
      .breadcrumb,
      .breadcrumbs,
      .product__breadcrumb { display: none !important; }

      /* ===== PRODUCT PAGE — SELETOR DE TAMANHO ===== */
      .selector-wrapper--size .radio__legend__value { display: none !important; }
      .selector-wrapper--size .radio__fieldset { display: block !important; }
      .selector-wrapper--size .radio__legend { margin-bottom: 8px; }
    </style>
    {%- comment -%} ===== FIM CUSTOM STYLES ===== {%- endcomment -%}
  </head>

  <body
    id="{{ page_title | handle }}"
    class="template-{{ template.name | handle }} grid-{{ settings.grid_style }}{% if customer %} customer-logged-in{% endif %}{% if settings.animations_enable %} aos-initialized{% endif %}{% if settings.product_grid_outline %} has-line-design{% endif %}"
    data-animations="{{ settings.animations_enable }}"
  >
    {%- render 'loading' -%}

    <a class="in-page-link visually-hidden skip-link" data-skip-content href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <div class="container" data-site-container>
      <div class="header-sections">
        {% sections 'group-header' %}
      </div>

      {% sections 'group-overlay' %}

      <!-- CONTENT -->
      <main role="main" id="MainContent" class="main-content">
        {{ content_for_layout }}
      </main>
    </div>

    {% sections 'group-pre-footer' %}

    <footer class="footer-sections">
      {% sections 'group-footer' %}
    </footer>

    {%- if settings.swatches_type != 'disabled' -%}
      {% render 'template-swatch' %}
    {%- endif -%}

    {% render 'zoom-pswp' %}

    {%- if template.name != 'product' and settings.show_scroll_top_button -%}
      <button
        type="button"
        class="btn btn--scroll-top btn--black btn--solid"
        aria-label="{{ 'general.accessibility.scroll_to_top' | t }}"
        data-scroll-top-button
      >
        {%- render 'icon-arrow-up' -%}
      </button>
    {%- endif -%}

    {%- comment -%}
      In order to use your custom javascript file at assets/custom.js
      just cut this next line and paste it outside this comment:
      <script src="{{ 'custom.js' | asset_url }}" defer="defer"></script>
    {%- endcomment -%}
    <!-- Paste marketing code or third party scripts below this comment line ============== -->

    {%- comment -%} ===== RABATT-BADGES AUF VIELFACHE VON 5 RUNDEN ===== {%- endcomment -%}
    <script>
      (function () {
        'use strict';

        // Einerstelle 1-4 -> 5, darueber -> naechster Zehner. 67 -> 70, 61 -> 65.
        function round5(n) {
          return n % 5 === 0 ? n : (Math.floor(n / 5) + 1) * 5;
        }

        // Der gesamte Inhalt muss der Badge entsprechen: "-67%", "67 %", "−67%"
        var BADGE = /^[\s ]*([-−–—]?)[\s ]*(\d{1,3})[\s ]*%[\s ]*$/;

        // Badge-Container dieses Themes zuerst, danach ein allgemeiner Durchlauf.
        var SELECTORS = [
          '.sale-box',
          '.product__price--off--custom',
          '.product__sale',
          '.price__badge',
          '[class*="badge"]',
          '[class*="sale"]',
          '[class*="discount"]'
        ].join(',');

        function rewrite(el) {
          var m = (el.textContent || '').match(BADGE);
          if (!m) return false;
          // nur das innerste Element anfassen, das die Badge komplett enthaelt
          var kids = el.querySelectorAll('*');
          for (var k = 0; k < kids.length; k++) {
            if (BADGE.test(kids[k].textContent || '')) return false;
          }
          var n = parseInt(m[2], 10);
          if (!(n >= 1 && n <= 99)) return false;
          var r = round5(n);
          if (r === n) return false;
          el.textContent = m[1] + r + '%';
          return true;
        }

        function fix(root) {
          if (!root || (root.nodeType !== 1 && root.nodeType !== 9)) return 0;
          var found = 0, i;

          var targets = root.querySelectorAll(SELECTORS);
          for (i = 0; i < targets.length; i++) {
            if (rewrite(targets[i])) found++;
          }

          // Fallback fuer Badges ohne passende Klasse
          var all = root.querySelectorAll('span,div,p,strong,em,small,b');
          for (i = 0; i < all.length; i++) {
            if (rewrite(all[i])) found++;
          }
          return found;
        }

        var total = 0;
        function run() { total += fix(document.body); }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run);
        } else {
          run();
        }
        window.addEventListener('load', run);
        [300, 800, 1500, 3000].forEach(function (ms) { setTimeout(run, ms); });

        // Karussells, Filter und Quick-View laden Inhalte nach
        var pending = null;
        new MutationObserver(function () {
          clearTimeout(pending);
          pending = setTimeout(run, 80);
        }).observe(document.documentElement, { childList: true, subtree: true });

        window.__rabattBadges = function () { return total; };
      })();
    </script>
    {%- comment -%} ===== ENDE RABATT-BADGES ===== {%- endcomment -%}

    <!-- And above this comment line ================================================== -->
  </body>
</html>
